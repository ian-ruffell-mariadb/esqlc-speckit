/* T639 — indicator association on the INPUT side. `:w :ind` associates;
   a comma separates list items and must not (FR-002.15). Gate 2 proved this
   for outputs; the input side has never been exercised. */
#pragma SQL
EXEC SQL BEGIN DECLARE SECTION;
  short part_num; short weight; short w_ind; char part_desc[19];
EXEC SQL END DECLARE SECTION;
int main(void) {
  /* one value with an indicator, plus a separate list item */
  EXEC SQL UPDATE parts SET weight = :weight :w_ind, part_desc = :part_desc
           WHERE part_num = :part_num;
  return 0;
}
