/* T311 — a cursor declared and never opened must still compile cleanly.
   The emitted statement text is a file-scope static; if it is emitted without
   care it draws an unused-variable warning in the customer's build. */
#pragma SQL
long sqlcode;
EXEC SQL BEGIN DECLARE SECTION;
  short min_num;
EXEC SQL END DECLARE SECTION;
EXEC SQL DECLARE unusedcur CURSOR FOR SELECT part_num FROM parts
         WHERE part_num >= :min_num;
int main(void) { return 0; }
