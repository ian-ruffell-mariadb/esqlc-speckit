# esqlc schema cache v1 — tab-separated, one column per line.
#
# SD-15: committed rather than generated at build time, so a build is
# reproducible without network access and a schema change shows up in review as
# a diff. Tab-separated rather than JSON because the preprocessor has no
# third-party dependencies and a JSON parser would be either a new dependency
# or ~150 lines of new attack surface for five fields per column.
#
# SD-16: the !captured line is the only staleness signal there is. The
# preprocessor cannot detect a stale cache — it has no connection, and
# NFR-001.2 forbids one — so it stamps this timestamp into generated output and
# leaves detection to the build system.
#
# There is no capture tool yet: this file is hand-written to match
# tests/conformance/gate-1/schema.sql. That is why SD-15 is provisional.
#
# table	column	sqltype	length	nullable	charset
!captured	2026-09-03T11:20:14Z
parts	part_num	SMALLINT	2	N	UNKNOWN
parts	part_desc	CHAR	18	N	ISO88591
parts	weight	SMALLINT	2	Y	UNKNOWN
charsets	k	SMALLINT	2	N	UNKNOWN
charsets	c_l1	CHAR	8	Y	ISO88591
charsets	c_l2	CHAR	8	Y	ISO88592
charsets	v_kr	VARCHAR	10	Y	KSC5601
charsets	c_greek	CHAR	8	Y	ISO88597
# Tables that exist only to drive a negative. Each is invoked by exactly one
# fixture, so the awkward column lives here rather than polluting a real table.
badtype	k	SMALLINT	2	N	UNKNOWN
badtype	g	GEOMETRY	0	Y	UNKNOWN
badident	k	SMALLINT	2	N	UNKNOWN
badident	int	SMALLINT	2	Y	UNKNOWN
longname	k	SMALLINT	2	N	UNKNOWN
longname	nullable_column_name_of_thirty	SMALLINT	2	Y	UNKNOWN
