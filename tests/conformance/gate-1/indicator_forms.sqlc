#pragma SQL
long sqlcode;
EXEC SQL BEGIN DECLARE SECTION;
  short part_num; short weight; short ind;
EXEC SQL END DECLARE SECTION;
int main(void) {
  EXEC SQL SELECT weight INTO :weight INDICATOR :ind FROM parts WHERE part_num = :part_num;
  EXEC SQL SELECT weight INTO :weight :ind FROM parts WHERE part_num = :part_num;
  return 0;
}
