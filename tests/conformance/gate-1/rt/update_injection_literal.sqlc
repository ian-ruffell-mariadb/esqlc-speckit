/* T622 — NFR-003.2 on the write path. The value is stored, never executed. */
#pragma SQL
#include <stdio.h>
#include <string.h>
long sqlcode;
EXEC SQL BEGIN DECLARE SECTION;
  short part_num; char part_desc[19];
EXEC SQL END DECLARE SECTION;

int main(void) {
  EXEC SQL BEGIN WORK;
  part_num = 4102;
  memcpy(part_desc, "'; DROP TABLE p ; ", 18);
  EXEC SQL UPDATE parts SET part_desc = :part_desc WHERE part_num = :part_num;
  if (sqlcode != 0) { printf("FAIL: update sqlcode=%ld\n", sqlcode); return 1; }
  EXEC SQL COMMIT WORK;
  printf("update_injection_literal ok\n");
  return 0;
}
