/* T406 — SQLCAGETINFOLIST over the numeric items. Sizes are per the manual's
   item table: items 1, 2, 3, 22 and 27 are 2 bytes; item 20 is 4. They are
   packed in request order at those sizes, not at a uniform stride. */
#pragma SQL
#include <stdio.h>
#include <string.h>
long sqlcode;
EXEC SQL INCLUDE SQLCA;
EXEC SQL BEGIN DECLARE SECTION;
  short part_num; char part_desc[19];
EXEC SQL END DECLARE SECTION;
int main(void) {
  int  items[3] = { 1, 2, 3 };            /* version, capacity, actual count */
  char buf[6];
  short version, capacity, actual;
  int rc;

  EXEC SQL BEGIN WORK;
  part_num = 4102; memcpy(part_desc, "DUPLICATE KEY ROW ", 18);
  EXEC SQL INSERT INTO parts (part_num, part_desc) VALUES (:part_num, :part_desc);
  if (sqlcode >= 0) { printf("FAIL: expected a duplicate-key failure\n"); return 1; }

  memset(buf, 0, sizeof buf);
  rc = esqlc_sqlca_getinfolist(&sqlca, 0, items, 3, buf, sizeof buf);
  memcpy(&version,  buf + 0, 2);
  memcpy(&capacity, buf + 2, 2);
  memcpy(&actual,   buf + 4, 2);
  EXEC SQL ROLLBACK WORK;
  printf("rc=%d version=%d capacity=%d actual=%d\n", rc, version, capacity, actual);
  return (rc == 0 && version == 2 && capacity == 7 && actual >= 1) ? 0 : 1;
}
