/* T048 — FR-003.10 / NFR-003.2. The value must be stored, never executed. */
#pragma SQL
#include <string.h>
long sqlcode;
EXEC SQL BEGIN DECLARE SECTION;
  short part_num; char part_desc[19];
EXEC SQL END DECLARE SECTION;
int main(void) {
  part_num = 9; memcpy(part_desc, "'; DROP TABLE parts", 18);
  EXEC SQL BEGIN WORK;
  EXEC SQL INSERT INTO parts (part_num, part_desc) VALUES (:part_num, :part_desc);
  EXEC SQL COMMIT WORK;
  return sqlcode == 0 ? 0 : 1;
}
