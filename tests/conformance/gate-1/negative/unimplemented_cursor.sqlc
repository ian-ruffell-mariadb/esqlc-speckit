/* T207 — keeps a live ESQLC-1012 case in the suite once SELECT becomes
   implemented. Uses FETCH rather than DECLARE ... CURSOR: see 004 Q9, the
   dispatch table cannot currently match the DECLARE form. */
#pragma SQL
long sqlcode;
EXEC SQL BEGIN DECLARE SECTION;
  short part_num;
EXEC SQL END DECLARE SECTION;
int main(void) {
  EXEC SQL FETCH c INTO :part_num;
  return 0;
}
