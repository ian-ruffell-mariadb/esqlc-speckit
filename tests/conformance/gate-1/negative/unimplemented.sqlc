/* Gate 1 fixture, repointed twice. It used SELECT as its example of an
   unimplemented statement; Gate 2 implemented that and moved it to UPDATE;
   Gate 6 implements that too, so it moves to PREPARE, which feature 007 owns.

   The churn is the fixture working as intended: each gate that implements the
   example has to find a new one, and the alternative is a fixture that
   silently stops testing FR-001.15 and starts testing something else. */
#pragma SQL
long sqlcode;
int main(void) {
  EXEC SQL PREPARE s1 FROM "SELECT part_num FROM parts";
  return 0;
}
